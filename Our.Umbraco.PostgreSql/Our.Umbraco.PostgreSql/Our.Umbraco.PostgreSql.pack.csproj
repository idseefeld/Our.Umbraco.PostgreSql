		<Description>Adds support for PostgreSQL to Umbraco CMS.</Description>
		<PackageTags>umbraco;umbraco-marketplace</PackageTags>
		<StaticWebAssetBasePath>\</StaticWebAssetBasePath>
		<RootNamespace>$(MSBuildProjectName.Replace(" ", "_").Replace(".pack", ""))</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<None Remove=".gitignore" />
		<None Remove="datetime-erros.playlist" />
		<None Remove="errors-2.playlist" />
		<None Remove="errors-3.playlist" />
		<None Remove="errors-new.playlist" />
		<None Remove="errors.playlist" />
		<None Remove="ExecuteScalar-errors.playlist" />
		<None Remove="file-open-error.playlist" />
		<None Remove="getalias-errors.playlist" />
		<None Remove="not-run.playlist" />
		<None Remove="postgresql-db.png" />
		<None Remove="second-half-of-integration-tests.playlist" />
		<None Remove="uElephant-Copilot_20260402_142603.png" />
		<None Remove="umb.sql" />
		<None Remove="umbMain.sql" />
		<None Remove="uniqueid-errors.playlist" />
		<None Remove="upostgresql.png" />
		<None Remove="upostgresql.psd" />
		<None Remove="upostgresqlfix.png" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="../readme.md" Pack="true" PackagePath="" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Npgsql" Version="10.0.3" />
		<PackageReference Include="Umbraco.Cms.Infrastructure" Version="[18.4.0-rc,18.5.0)" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Our.Umbraco.PostgreSql.EFCore\Our.Umbraco.PostgreSql.EFCore.pack.csproj" Version="[18.2.0,19.0.0)" />
	</ItemGroup>

	<!-- Synchronize Umbraco Package Version build task from Directory.Build.props to umbraco-package.json -->
	<UsingTask TaskName="SynchronizeUmbracoPackageVersion" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
		<ParameterGroup>
			<ManifestPath ParameterType="System.String" Required="true" />
			<Version ParameterType="System.String" Required="true" />
		</ParameterGroup>
		<Task>
			<Using Namespace="System.IO" />
			<Using Namespace="System.Text" />
			<Using Namespace="System.Text.RegularExpressions" />
			<Code Type="Fragment" Language="cs">
				<![CDATA[
        if (!Regex.IsMatch(Version, @"^[0-9A-Za-z.+-]+$"))
        {
            Log.LogError("The package version '{0}' cannot be written to the Umbraco manifest.", Version);
            return false;
        }

        var encoding = new UTF8Encoding(false, true);
        var content = encoding.GetString(File.ReadAllBytes(ManifestPath));
        var matches = Regex.Matches(content, @"(?m)^[ \t]*""version""[ \t]*:[ \t]*""(?<value>[^""\r\n\\]*)""[ \t]*,?[ \t]*\r?$");
        if (matches.Count != 1)
        {
            Log.LogError("Expected exactly one version property in the Umbraco manifest '{0}', but found {1}.", ManifestPath, matches.Count);
            return false;
        }

        var value = matches[0].Groups["value"];
        if (value.Value != Version)
        {
            content = content.Remove(value.Index, value.Length).Insert(value.Index, Version);
            File.WriteAllBytes(ManifestPath, encoding.GetBytes(content));
            Log.LogMessage(MessageImportance.High, "Updated Umbraco manifest version to {0}.", Version);
        }
      ]]>
			</Code>
		</Task>
	</UsingTask>

	<Target Name="SynchronizeUmbracoPackageManifestVersion" BeforeTargets="PrepareForBuild;ResolveStaticWebAssetsInputs;GenerateNuspec" Condition="'$(DesignTimeBuild)' != 'true'">
		<SynchronizeUmbracoPackageVersion ManifestPath="$(MSBuildProjectDirectory)\wwwroot\App_Plugins\$(PackageId)\umbraco-package.json" Version="$(Version)" />
	</Target>
</Project>
